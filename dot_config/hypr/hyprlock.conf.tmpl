general {
	hide_cursor = true
    ignore_empty_input = true
}

background {
    path = ~/.config/hypr/wallpaper_current
    brightness = 0.8
    blur_passes = 2
    blur_size = 2
    noise = 0.10
}

label {
	font_size = 48
	font_family = {{ .font }}
	text = cmd[update:1000] echo "<span>$(date +"%H:%M")</span>"
	color = rgb(FFFFFF)
	position = 0,48
	halign = center
	valign = center
}

label {
	font_size = 30
	font_family = {{ .font }}
	text = cmd[update:1000] echo "<span>$(date +"%g-%m-%d")</span>"
	color = rgb(FFFFFF)
	position = 0,0
	halign = center
	valign = center
}

input-field {
	size = 190, 24
	font_family = {{ .font }}
	outline_thickness = 1
	dots_center = true
	inner_color = rgba(54, 54, 54, 0.3)
	outer_color = {{ .colors.border | replace "#" "rgb(" }})
	check_color = {{ .colors.accent | replace "#" "rgb(" }})
	fail_color = rgba(200, 80, 80, 0.6)
	font_color = rgb(FFFFFF)
	fade_on_empty = true
	placeholder_text =
	rounding = {{ .rounding }}
	position = 0, -38
	halign = center
	valign = center
}
